# Referencia de variables: el servicio no lee este archivo, van exportadas o en la línea de comando.
PORT=3000
MONGO_URI=mongodb://localhost:27017/discordia_chat
REDIS_URL=redis://localhost:6379
CORE_SERVICE_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8000
RABBITMQ_URL=amqp://user:password@localhost:5672/
RABBITMQ_EXCHANGE=server.events
RABBITMQ_QUEUE=chat_engine_events
