{
  "name": "chat-engine-service",
  "version": "1.0.0",
  "description": "Discordia Real-Time Chat Engine Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "c8 --check-coverage --lines 85 --functions 85 --branches 85 --statements 85 --reporter=text --reporter=lcov tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.4",
    "ioredis": "^5.4.1",
    "mongodb": "^6.8.0",
    "mongoose": "^9.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "c8": "^10.1.2",
    "eslint": "^9.9.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.9.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "ws": "^8.21.3"
  }
}
